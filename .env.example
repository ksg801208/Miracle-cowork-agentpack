# Miracle-Cowork AgentPack 환경변수 설정 예시
# 이 파일을 복사하여 .env 로 저장하고 값을 채워주세요.
# cp .env.example .env

# ── Agent 실행 모드 ──────────────────────────────
# mock : 템플릿 기반 Mock 출력 (기본값, API 키 불필요)
# llm  : 실제 LLM API 호출
AGENT_RUNNER_MODE=mock

# ── Anthropic Claude API ─────────────────────────
# AGENT_RUNNER_MODE=llm 일 때만 필요합니다.
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-api03-...

# 사용할 Claude 모델 (기본값: claude-sonnet-4-6)
# 선택 옵션: claude-haiku-4-5-20251001 | claude-sonnet-4-6 | claude-opus-4-7
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── JWT 인증 ─────────────────────────────────────
# 반드시 충분히 긴 랜덤 문자열로 변경하세요 (예: openssl rand -hex 32)
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── 데이터베이스 ─────────────────────────────────
DATABASE_URL=sqlite:///./miracle_agentpack.db
